# Module images on the captf OpenTofu base. One Dockerfile for every image:
# IMAGE picks the module (build/src/<image>, which `make fetch` fills from
# the release pinned in sources/versions.tf) and its lock file, ROLE sets
# io.captf.role, and --target picks the final stage, which must be the role.
#
#   podman build -f Dockerfile.opentofu --build-arg IMAGE=aws-machine \
#     --build-arg ROLE=machine --target machine \
#     --label 'io.captf.capacity={"cpu":"2","memory":"8Gi"}' \
#     --label 'io.captf.node-info={"architecture":"amd64","operatingSystem":"linux"}' \
#     -t aws-machine:opentofu .
#
# `make build` sets all of it from images.json; Dockerfile.terraform is the
# same file on the Terraform base. Dependabot bumps the pinned FROM lines,
# and hack/lock.sh reads the base image from the `AS mirror` line.

# Hermetic provider mirror for every platform the image publishes. The
# image's lock file pins the provider versions the mirror downloads
# (`providers mirror` selects the version the lock file records); the exact
# pin in the module's versions.tf agrees with it. Needs registry egress at
# build time. The mirror holds both platforms whatever platform builds it, so
# it runs on the build platform: no emulation for the arm64 image.
FROM --platform=$BUILDPLATFORM ghcr.io/captf-io/opentofu-base:1.12.7@sha256:14119975abd505e1dc68492fee54f0e2eae17d39e73d589e011dbde50da0cd8a AS mirror
ARG IMAGE
USER root
WORKDIR /src
COPY build/src/${IMAGE}/ .
COPY locks/opentofu/${IMAGE}.terraform.lock.hcl .terraform.lock.hcl
# get: `providers mirror` refuses a module whose nested local modules are not
# installed. mkdir: `providers mirror` does not create the target when the
# module requires no providers, and the COPY --from=mirror below needs it.
RUN tofu get \
 && mkdir -p /captf/providers \
 && tofu providers mirror -platform=linux_amd64 -platform=linux_arm64 /captf/providers
# This stage is not shipped. It drops root again so the last USER of every
# stage is unprivileged (trivy DS-0002).
USER 65532:65532

FROM ghcr.io/captf-io/opentofu-base:1.12.7@sha256:14119975abd505e1dc68492fee54f0e2eae17d39e73d589e011dbde50da0cd8a AS module
ARG IMAGE
ARG ROLE
ARG IMAGE_SOURCE=""
ARG IMAGE_REVISION=""
ARG IMAGE_VERSION=""
ARG IMAGE_URL=""
COPY --from=mirror --chown=65532:65532 /captf/providers /captf/providers
# build/src/<image> holds the module files only (hack/fetch.sh).
COPY --chown=65532:65532 build/src/${IMAGE}/ /captf/module
# io.captf.contract, io.captf.runtime and io.captf.runtime.version come from
# the base. image.version is the module release; image.url is its
# repository.
LABEL io.captf.role="${ROLE}" \
      org.opencontainers.image.source="${IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.url="${IMAGE_URL}"

FROM module AS cluster

FROM module AS machinepool

# The final stage is the role. The capacity labels for scale from zero
# (io.captf.capacity and io.captf.node-info, image contract "OCI labels")
# describe a machine module's default instance shape, so they are per image,
# not per role: images.json holds them, and `make build` and the publish job
# add them with --label. The contract wants them identical on every platform
# of the index, so the architecture is fixed there, never TARGETARCH. An
# image without a default shape (openstack-machine) carries neither.
FROM module AS machine
